# Keep this file private. Copy to .env and fill your secret.
OPENAI_API_KEY=your_openai_api_key_here
# Set to a model enabled for your OpenAI API project.
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
MAX_OUTPUT_TOKENS=6000
# Required in production. Use a long unique random secret.
APP_ACCESS_PASSWORD=replace-with-a-long-random-password
